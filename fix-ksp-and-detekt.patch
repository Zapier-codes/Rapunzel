diff --git a/app/src/main/java/io/aatricks/easyreader/data/remote/wattpad/WattpadAuthInterceptor.kt b/app/src/main/java/io/aatricks/easyreader/data/remote/wattpad/WattpadAuthInterceptor.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/io/aatricks/easyreader/data/remote/wattpad/WattpadAuthInterceptor.kt
@@ -0,0 +1,33 @@
+package io.aatricks.easyreader.data.remote.wattpad
+
+import okhttp3.Interceptor
+import okhttp3.Response
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * OkHttp interceptor that injects Wattpad auth tokens into requests.
+ */
+@Singleton
+class WattpadAuthInterceptor @Inject constructor() : Interceptor {
+
+    @Volatile
+    private var token: String? = null
+
+    fun setToken(newToken: String) {
+        token = newToken
+    }
+
+    fun clearToken() {
+        token = null
+    }
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        val authenticatedRequest = token?.let { t ->
+            request.newBuilder()
+                .header("Authorization", "Bearer $t")
+                .build()
+        } ?: request
+        return chain.proceed(authenticatedRequest)
+    }
+}
